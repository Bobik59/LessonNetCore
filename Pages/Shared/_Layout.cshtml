<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewData["Title"] - GameStoreApp</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" integrity="sha384-KyZXEAg3QhqLMpG8r+Knujsl5+5hb7MW5N5L5H/2n5F5F5l5K5l5F5F5F5l5K5" crossorigin="anonymous">

</head>
<body>
    <header>
        <h1>Game Store</h1>
        <nav>
            <a asp-page="/Games/Index">Игры</a>
        </nav>
    </header>
    <main role="main" class="container">
        @RenderBody()
    </main>
    <footer>
        <p>&copy; @DateTime.Now.Year - GameStoreApp</p>
    </footer>
    @RenderSection("Scripts", required: false)
</body>
</html>
