@page "{id:int}"
@model LessonNetCore.Pages.Games.EditModel
@{
    ViewData["Title"] = "Редактировать игру";
}

<h1>Редактировать игру</h1>

<form method="post">
    <input type="hidden" asp-for="Game.Id" />
    <div class="form-group">
        <label asp-for="Game.Name"></label>
        <input asp-for="Game.Name" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Game.Genre"></label>
        <input asp-for="Game.Genre" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Game.Author"></label>
        <input asp-for="Game.Author" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Game.ReleaseDate"></label>
        <input asp-for="Game.ReleaseDate" type="date" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
</form>

<a asp-page="./Index">Отмена</a>
