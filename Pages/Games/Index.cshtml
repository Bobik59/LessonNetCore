@page
@model LessonNetCore.Pages.Games.IndexModel
@{
    ViewData["Title"] = "Список игр";
}

<h1>Список игр</h1>

<form method="get" class="mb-3">
    <input type="text" name="Author" placeholder="Автор" value="@Model.Author" class="form-control mb-2" />
    <input type="text" name="Genre" placeholder="Жанр" value="@Model.Genre" class="form-control mb-2" />
    <button type="submit" class="btn btn-primary">Фильтровать</button>
</form>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Название</th>
            <th>Жанр</th>
            <th>Автор</th>
            <th>Дата выпуска</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var game in Model.Games)
        {
            <tr>
                <td>@game.Id</td>
                <td>@game.Name</td>
                <td>@game.Genre</td>
                <td>@game.Author</td>
                <td>@game.ReleaseDate.ToShortDateString()</td>
                <td>
                    <a asp-page="./Details" asp-route-id="@game.Id" class="btn btn-info btn-sm">Просмотр</a>
                    <a asp-page="./Edit" asp-route-id="@game.Id" class="btn btn-warning btn-sm">Редактировать</a>
                    <a asp-page="./Delete" asp-route-id="@game.Id" class="btn btn-danger btn-sm">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-page="./Create" class="btn btn-success">Добавить новую игру</a>
