@page "{id:int}"
@model LessonNetCore.Pages.Games.DetailsModel
@{
    ViewData["Title"] = "Детали игры";
}

<h1>Детали игры</h1>

<div>
    <h4>@Model.Game.Name</h4>
    <dl class="row">
        <dt class="col-sm-2">Жанр</dt>
        <dd class="col-sm-10">@Model.Game.Genre</dd>
        <dt class="col-sm-2">Автор</dt>
        <dd class="col-sm-10">@Model.Game.Author</dd>
        <dt class="col-sm-2">Дата выпуска</dt>
        <dd class="col-sm-10">@Model.Game.ReleaseDate.ToShortDateString()</dd>
    </dl>
</div>

<a asp-page="./Index">Назад к списку</a>
