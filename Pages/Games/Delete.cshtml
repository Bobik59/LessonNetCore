@page
@model LessonNetCore.Pages.Games.DeleteModel
@{
    ViewData["Title"] = "Удалить игру";
}

<h1>Удалить игру</h1>

<p>Вы уверены, что хотите удалить игру "<strong>@Model.Game.Name</strong>"?</p>

<form method="post">
    <input type="hidden" asp-for="Game.Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
</form>